# OpenAI key used by the Answer Agent (final response formatting)
API_KEY=sk-...

# OpenRouter key used by the Retriever Agent (query rewriting) and the
# Analyst Agent (analysis + sufficiency checks)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Where vector_store.index and metadata.pkl live
DATA_DIR=./data
